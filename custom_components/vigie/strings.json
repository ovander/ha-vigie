  "exceptions": {
    "no_own_position": {
      "message": "No own position: wait for a GPS fix, or give the anchor's latitude and longitude."
    },
    "unknown_entry": {
      "message": "No Vigie boat has the entry ID {entry_id}."
    },
    "entry_not_loaded": {
      "message": "{boat} is not running: check its serial port."
    },
    "recenter_needs_position": {
      "message": "Recentering needs the anchor's latitude and longitude."
    },
    "anchor_not_armed": {
      "message": "The anchor watch is off: drop the anchor first."
    },
    "anchor_alarm_on": {
      "message": "The anchor alarm is on: deal with it, or raise the anchor and drop it again, before recentering."
    }
  },
  "services": {
    "drop_anchor": {
      "name": "Drop anchor",
      "description": "Starts the anchor watch at the boat's position, or at the given point, with the given radius. Dropping again moves the anchor and clears the alarm.",
      "fields": {
        "config_entry_id": {
          "name": "Boat",
          "description": "The Vigie boat whose anchor watch to change."
        },
        "latitude": {
          "name": "Latitude",
          "description": "Anchor latitude, for example read on the chartplotter. Give it with the longitude, or leave both empty for the boat's position."
        },
        "longitude": {
          "name": "Longitude",
          "description": "Anchor longitude; given with the latitude."
        },
        "radius": {
          "name": "Radius",
          "description": "Swing radius in metres (10–500). Leave empty to keep the current one."
        },
        "keep_since": {
          "name": "Recenter",
          "description": "Move the circle of a watch already on, to the given point, keeping the time it was armed and the swing track: for when the boat had dropped back before the watch was turned on. Needs the latitude and longitude; refused while the anchor alarm is on."
        }
      }
    },
    "raise_anchor": {
      "name": "Raise anchor",
      "description": "Stops the anchor watch and clears its alarm.",
      "fields": {
        "config_entry_id": {
          "name": "Boat",
          "description": "The Vigie boat whose anchor watch to change."
        }
      }
    }
  }
